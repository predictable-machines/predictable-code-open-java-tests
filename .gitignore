# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Exception: this one is committed on purpose, as the binary-only dependency
# described in lib/README.md. It is checked in because there is no source for it
# anywhere in the tree, which is the whole point of the fixture.
!lib/moneyguard.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local tool state. This repository is public and nothing produced by a local
# run belongs in it: those files carry absolute paths and machine-specific
# dependency wiring. Ignore the whole directory rather than picking through it.
.predictable-code/

# Editor and agent local settings
.claude/
.idea/
.vscode/
